{
  "name": "OpenHU Plugins",
  "description": "Official plugins for OpenHU: CAN bus, steering wheel keys, reverse camera, vehicle data logger, FM/AM/DAB+ radio",
  "maintainer": "Leon Strauß <openhu.dev@alias.strauss-hub.de>",
  "api": 2,
  "plugins": [
    {
      "id": "org.beegor.display",
      "name": "Display control",
      "version": "1.0.3",
      "description": "Set monitor brightness from CAN and power off the system after ignition-off delay.",
      "arch": [
        "all"
      ],
      "api": 2,
      "permissions": [],
      "packages": [
        "ddcutil"
      ],
      "archive": "dist/org.beegor.display-1.0.3.tar.gz",
      "sha256": "1122974a10cb02f6003db71db825f07c436e85e9a5b4eacdda8bc390ae551542",
      "size": 10153
    },
    {
      "id": "org.openhu.camera",
      "name": "Reverse camera",
      "version": "1.0.0",
      "description": "Camera picture with guide lines in the content area or full screen, automatically in reverse gear (CAN plugin) or with the actions camera.show / camera.hide / camera.toggle.",
      "arch": [
        "all"
      ],
      "api": 2,
      "permissions": [
        "camera"
      ],
      "recommends": [
        "org.openhu.vehicle"
      ],
      "archive": "dist/org.openhu.camera-1.0.0.tar.gz",
      "sha256": "bc1c81d59bd42fda51e79b3740449dcca259c3901780f31cf2172daac955fbe6",
      "size": 9319
    },
    {
      "id": "org.openhu.can",
      "name": "CAN bus",
      "version": "1.0.2",
      "description": "Vehicle data (speed, gear, lights …) and steering wheel keys from the CAN bus via SocketCAN. Vehicle profiles describe the CAN IDs.",
      "arch": [
        "all"
      ],
      "api": 2,
      "permissions": [
        "can",
        "input"
      ],
      "androidAuto": {
        "sensors": [
          "speed",
          "fuel",
          "odometer",
          "engine",
          "climate",
          "drivingStatus",
          "info"
        ]
      },
      "archive": "dist/org.openhu.can-1.0.2.tar.gz",
      "sha256": "fd23936d38fe3812ae08aa31e1348472a9b562ab69fcd91db62f0e1cf677c614",
      "size": 15353
    },
    {
      "id": "org.openhu.display",
      "name": "Display control",
      "version": "1.0.0",
      "description": "Set monitor brightness from a CAN dimmer byte and open a black screen with status bar settings.",
      "arch": [
        "all"
      ],
      "api": 2,
      "permissions": [],
      "packages": [
        "ddcutil"
      ],
      "archive": "dist/org.openhu.display-1.0.0.tar.gz",
      "sha256": "8ade9af527ee40002ef217bde20d2b37abe26f4af63620631046f0438bc51db6",
      "size": 7630
    },
    {
      "id": "org.openhu.logger",
      "name": "Vehicle data logger",
      "version": "1.0.0",
      "description": "Records vehicle data (from the CAN plugin), Android Auto state and head unit values on the device, detects trips and offers the data to other plugins. Offline, off until switched on.",
      "arch": [
        "all"
      ],
      "api": 2,
      "permissions": [
        "storage"
      ],
      "recommends": [
        "org.openhu.vehicle"
      ],
      "archive": "dist/org.openhu.logger-1.0.0.tar.gz",
      "sha256": "98f6dd1a2b1231062dbda4786d1295dd04363084ec88a99ab3955ecae4223236",
      "size": 41081
    },
    {
      "id": "org.openhu.radio",
      "name": "Radio",
      "version": "1.0.0",
      "description": "FM/AM/DAB+ radio with an RTL-SDR USB stick: station scan, favorites, RDS (station name, radio text, PI) and DAB+ with DLS and slideshow (decoders included), station logos from your own image files. For testing without a stick: a simulated stick with internet radio streams.",
      "arch": [
        "amd64",
        "arm64"
      ],
      "api": 2,
      "permissions": [
        "audio",
        "usb"
      ],
      "packages": [
        "rtl-sdr",
        "pulseaudio-utils",
        "sox",
        "librtlsdr0",
        "libfaad2",
        "libfftw3-single3",
        "libsamplerate0",
        "libliquid1",
        "libsndfile1"
      ],
      "androidAuto": {
        "services": [
          "radio"
        ]
      },
      "archives": {
        "amd64": {
          "archive": "dist/org.openhu.radio-1.0.0-amd64.tar.gz",
          "sha256": "9172c99ac8ac3489f7f4e269004ce506bb12db9d0873f2c45977cb8e9fdd51a4",
          "size": 527160
        },
        "arm64": {
          "archive": "dist/org.openhu.radio-1.0.0-arm64.tar.gz",
          "sha256": "8971646e740dc54a14e244214cb97ea11c82e81a39c095deef843e9341f8efbd",
          "size": 489830
        }
      }
    },
    {
      "id": "org.openhu.swc",
      "name": "Steering wheel keys",
      "version": "1.0.0",
      "description": "Keys of input devices (USB steering wheel adapters, IR remote controls, multimedia keyboards) as OpenHU actions, with a learn mode.",
      "arch": [
        "all"
      ],
      "api": 2,
      "permissions": [
        "input"
      ],
      "archive": "dist/org.openhu.swc-1.0.0.tar.gz",
      "sha256": "e793f22c0d901159013772d7b9b2bf7e8ffb0fa018ab2b135f3d9a51d5d93366",
      "size": 9690
    },
    {
      "id": "org.openhu.vehicle",
      "name": "Vehicle data",
      "version": "1.0.0",
      "description": "Passes the vehicle data of the CAN plugin (speed, gear, parking brake, fuel …) to Android Auto and to the vehicle topics of OpenHU.",
      "arch": [
        "all"
      ],
      "api": 2,
      "permissions": [],
      "androidAuto": {
        "sensors": [
          "speed",
          "parkingBrake",
          "gear",
          "fuel",
          "odometer",
          "engine",
          "climate",
          "compass",
          "drivingStatus",
          "info"
        ],
        "services": [
          "carControl"
        ]
      },
      "requires": {
        "org.openhu.can": "1.0.0"
      },
      "archive": "dist/org.openhu.vehicle-1.0.0.tar.gz",
      "sha256": "bb42cad837c763327e303932fa760b646007f63b6f3947b3b1e9707339a7f573",
      "size": 7501
    }
  ]
}
