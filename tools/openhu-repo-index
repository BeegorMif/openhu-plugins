#!/usr/bin/env python3
"""Builds an OpenHU plugin repository: dist/<id>-<version>.tar.gz and index.json.

    tools/openhu-repo-index [repository]      (default: current directory)
    tools/openhu-repo-index --native-arches   plugins and architectures with native tools ("<id> <arch>" lines)

Layout:
    repo.json                   {"name": ..., "description": ..., "maintainer": ...}
    plugins/<id>/manifest.json  one folder per plugin
    common/                     shared files, copied into a plugin's lib/ when listed in its
                                manifest ("shared": ["openhu.py"])
    plugins/<id>/i18n/          translations, <language>.ts and the compiled .qm (tools/openhu-translations)
    plugins/<id>/bin/<arch>/    native programs of a plugin whose manifest names architectures ("arch": ["amd64",
                                "arm64"]): one archive per architecture, dist/<id>-<version>-<arch>.tar.gz, with only
                                its own bin/<arch>/ (built by plugins/<id>/native/build.sh, not committed). The
                                index entry lists them under "archives" ({arch: {archive, sha256, size}}).
    dist/sources/               source archives of the native programs (GPL: published next to the binaries), as
                                listed in bin/<arch>/build-info.json ("sources")

Archives are reproducible (sorted entries, fixed timestamps and owners), so unchanged plugins keep
their checksum. Run it after every change and commit dist/ and index.json; OpenHU installs the
archives and verifies the sha256 from index.json.
"""

import glob
import gzip
import hashlib
import io
import json
import os
import re
import sys
import tarfile

ARCHES = ("amd64", "arm64", "armhf", "i386")
ID_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
VERSION_PATTERN = re.compile(r"^\d+(\.\d+)*$")
REQUIRED = ("id", "name", "version")
# Plugin API of the OpenHU this repository is made for (2 = Qt 6)
API = 2


def fail(message):
    print("error: " + message, file=sys.stderr)
    sys.exit(1)


def add_file(tar, path, arcname):
    info = tar.gettarinfo(path, arcname)
    info.mtime = 0
    info.uid = info.gid = 0
    info.uname = info.gname = ""
    info.mode = 0o755 if os.access(path, os.X_OK) else 0o644
    with open(path, "rb") as file:
        tar.addfile(info, file)


def native_arches(manifest):
    """Architectures with an archive of their own; [] for "all" (one archive for every machine)."""
    arches = manifest.get("arch", ["all"])
    if not isinstance(arches, list) or not arches or "all" in arches:
        return []
    unknown = [arch for arch in arches if arch not in ARCHES]
    if unknown:
        fail("%s: unknown arch %s (%s)" % (manifest["id"], ", ".join(unknown), ", ".join(ARCHES)))
    return arches


def build_archive(repo, plugin_dir, manifest, arch=None):
    """Reproducible tar.gz of a plugin; with arch only that architecture's bin/<arch>/ (no other one)."""
    plugin_id = manifest["id"]
    bin_dir = os.path.join(plugin_dir, "bin")
    files = []
    for root, dirs, names in os.walk(plugin_dir):
        dirs[:] = sorted(d for d in dirs if d not in ("__pycache__", ".git", "tests")
                         and not (root == bin_dir and d in ARCHES and d != arch))
        for name in sorted(names):
            if name.endswith(".pyc"):
                continue
            path = os.path.join(root, name)
            files.append((path, plugin_id + "/" + os.path.relpath(path, plugin_dir)))
    for shared in manifest.get("shared", []):
        path = os.path.join(repo, "common", shared)
        if not os.path.isfile(path):
            fail("%s: shared file common/%s not found" % (plugin_id, shared))
        files.append((path, plugin_id + "/lib/" + shared))

    raw = io.BytesIO()
    with tarfile.open(fileobj=raw, mode="w", format=tarfile.PAX_FORMAT) as tar:
        for path, arcname in sorted(files, key=lambda entry: entry[1]):
            add_file(tar, path, arcname)

    compressed = io.BytesIO()
    with gzip.GzipFile(fileobj=compressed, mode="wb", mtime=0, filename="") as gz:
        gz.write(raw.getvalue())
    return compressed.getvalue()


def native_sources(plugin_dir, manifest, arch):
    """Source archives the native programs of an architecture were built from (build-info.json "sources")."""
    path = os.path.join(plugin_dir, "bin", arch, "build-info.json")
    try:
        with open(path) as file:
            sources = json.load(file).get("sources", [])
    except (OSError, ValueError):
        sources = []
    if not sources:
        fail("%s: %s missing or without \"sources\": build the native programs with "
             "plugins/%s/native/build.sh" % (manifest["id"], os.path.relpath(path), manifest["id"]))
    return sources


def write_archive(repo, name, data):
    with open(os.path.join(repo, name), "wb") as file:
        file.write(data)
    return {"archive": name, "sha256": hashlib.sha256(data).hexdigest(), "size": len(data)}


def load_manifests(repo):
    plugins_dir = os.path.join(repo, "plugins")
    for folder in sorted(os.listdir(plugins_dir)):
        manifest_path = os.path.join(plugins_dir, folder, "manifest.json")
        if os.path.isfile(manifest_path):
            with open(manifest_path) as file:
                yield folder, manifest_path, json.load(file)


def main():
    args = sys.argv[1:]
    if args and args[0] == "--native-arches":
        repo = os.path.abspath(args[1] if len(args) > 1 else ".")
        for folder, _, manifest in load_manifests(repo):
            for arch in native_arches(manifest):
                print(folder, arch)
        return
    repo = os.path.abspath(args[0] if args else ".")
    try:
        with open(os.path.join(repo, "repo.json")) as file:
            info = json.load(file)
    except (OSError, ValueError) as error:
        fail("repo.json: %s" % error)

    plugins_dir = os.path.join(repo, "plugins")
    dist_dir = os.path.join(repo, "dist")
    os.makedirs(dist_dir, exist_ok=True)

    entries = []
    archives = set()
    sources = set()
    for folder, manifest_path, manifest in load_manifests(repo):
        plugin_dir = os.path.join(plugins_dir, folder)
        missing = [key for key in REQUIRED if not manifest.get(key)]
        if missing:
            fail("%s: missing %s" % (manifest_path, ", ".join(missing)))
        if manifest["id"] != folder or not ID_PATTERN.match(folder):
            fail("%s: id must match the folder name" % manifest_path)
        if not VERSION_PATTERN.match(manifest["version"]):
            fail("%s: version must look like 1.2.3" % manifest_path)

        # translations: the compiled .qm next to every .ts (tools/openhu-translations; OpenHU loads the .qm)
        for ts in sorted(glob.glob(os.path.join(plugin_dir, "i18n", "*.ts"))):
            if not os.path.isfile(ts[:-3] + ".qm"):
                fail("%s: %s.qm missing, run tools/openhu-translations" % (manifest["id"], os.path.relpath(ts, repo)[:-3]))

        entry = {}
        arches = native_arches(manifest)
        if arches:
            entry["archives"] = {}
            for arch in arches:
                native = os.path.join(plugin_dir, "bin", arch)
                if not os.path.isdir(native) or not os.listdir(native):
                    fail("%s: bin/%s/ is empty: build the native programs with plugins/%s/native/build.sh (the "
                         "index workflow does that for every architecture)" % (manifest["id"], arch, folder))
                for source in native_sources(plugin_dir, manifest, arch):
                    if not os.path.isfile(os.path.join(dist_dir, "sources", source)):
                        fail("%s: source archive dist/sources/%s missing (native/build.sh --sources dist/sources)"
                             % (manifest["id"], source))
                    sources.add(source)
                archive = "dist/%s-%s-%s.tar.gz" % (manifest["id"], manifest["version"], arch)
                archives.add(os.path.basename(archive))
                entry["archives"][arch] = write_archive(repo, archive, build_archive(repo, plugin_dir, manifest, arch))
                print("%-28s %-8s %s" % (manifest["id"], manifest["version"], archive))
        else:
            archive = "dist/%s-%s.tar.gz" % (manifest["id"], manifest["version"])
            archives.add(os.path.basename(archive))
            entry = write_archive(repo, archive, build_archive(repo, plugin_dir, manifest))
            print("%-28s %-8s %s" % (manifest["id"], manifest["version"], archive))

        entries.append({
            "id": manifest["id"],
            "name": manifest["name"],
            "version": manifest["version"],
            "description": manifest.get("description", ""),
            "arch": manifest.get("arch", ["all"]),
            # plugin API (OpenHU only installs plugins made for its version), 1 = Qt 5 era
            "api": manifest.get("api", 1),
            "permissions": manifest.get("permissions", []),
            # Debian packages the plugin needs on the head unit (informational)
            **({"packages": manifest["packages"]} if manifest.get("packages") else {}),
            **entry,
        })

    for name in os.listdir(dist_dir):
        if name.endswith(".tar.gz") and name not in archives:
            os.remove(os.path.join(dist_dir, name))
            print("removed dist/" + name)
    # source archives no published binary was built from any more
    sources_dir = os.path.join(dist_dir, "sources")
    for name in sorted(os.listdir(sources_dir)) if os.path.isdir(sources_dir) else []:
        if name not in sources:
            os.remove(os.path.join(sources_dir, name))
            print("removed dist/sources/" + name)

    index = {
        "name": info.get("name", os.path.basename(repo)),
        "description": info.get("description", ""),
        "maintainer": info.get("maintainer", ""),
        "api": API,
        "plugins": entries,
    }
    with open(os.path.join(repo, "index.json"), "w") as file:
        json.dump(index, file, indent=2, ensure_ascii=False)
        file.write("\n")
    print("index.json: %d plugins" % len(entries))


if __name__ == "__main__":
    main()
