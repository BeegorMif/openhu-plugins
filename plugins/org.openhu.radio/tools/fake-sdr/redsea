#!/usr/bin/env python3
"""Simulated redsea (see fakesdr.py): consumes the multiplex on stdin and prints one JSON line per second with
the tuned station's name (ps) and radiotext (stream title from the ICY metadata, "rt" or the name)."""

import sys
import threading
import time

import fakesdr


def drain(done):
    try:
        while sys.stdin.buffer.read1(65536):
            pass
    except (OSError, ValueError):
        pass
    done.set()


def main():
    if "--version" in sys.argv[1:]:
        print("redsea 1.3.1 (fake-sdr)")
        return 0
    done = threading.Event()
    threading.Thread(target=drain, args=(done,), daemon=True).start()
    try:
        while not done.wait(1):
            state = fakesdr.read_state()
            station, pid = state.get("station"), state.get("pid")
            if station and pid and fakesdr.process_alive(pid):
                print(fakesdr.redsea_line(station, state.get("title")), flush=True)
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
