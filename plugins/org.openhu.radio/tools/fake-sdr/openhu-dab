#!/usr/bin/env python3
"""Simulated openhu-dab (see fakesdr.py and native/openhu-dab): same options and events as the real one, with the
ensembles of the "dab" section of the station list.

--channel CH [--service SID]: after OPENHU_FAKE_SDR_DAB_SYNC_SECONDS (default 1.5, like a receiver that has to sync)
the ensemble and its services; a channel without an ensemble in the list reports "sync" false. The service plays
as PCM (s16le, stereo, --rate) on stdout from its stream, tone or file via ffmpeg. DLS: "dls", else the stream's
ICY title, else the label. Slides: the service's "slides" one after the other (slideSeconds), as files in --slides
or base64. --scan: every channel, OPENHU_FAKE_SDR_DAB_SCAN_SECONDS (default 0.1) each. With "error" in the list it
fails like the real one without a stick ("no-device") or with a busy one ("busy")."""

import argparse
import base64
import ctypes
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.request

import fakesdr

VERSION = "1.0.0"
USER_AGENT = "OpenHU-fake-sdr/1.0"
STOP = threading.Event()


class Events:
    def __init__(self, fd):
        self.fd = fd
        self.lock = threading.Lock()

    def send(self, event, **data):
        line = (json.dumps(dict(event=event, **data), ensure_ascii=False) + "\n").encode()
        with self.lock:
            try:
                os.write(self.fd, line)
            except OSError:
                STOP.set()


def die_with_parent():
    """ffmpeg ends with this process."""
    try:
        ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    except (OSError, AttributeError):
        pass


def open_source(service, rate):
    """ffmpeg arguments producing s16le stereo PCM on stdout, plus an optional (response, metaint) for its stdin."""
    output = ["-vn", "-ac", "2", "-ar", str(rate), "-f", "s16le", "pipe:1"]
    base = ["ffmpeg", "-hide_banner", "-nostats", "-loglevel", "error"]
    if service.get("tone"):
        return base + ["-re", "-f", "lavfi", "-i", "sine=frequency=%d" % int(service["tone"])] + output, None
    url = str(service.get("url") or "")
    if not url.startswith(("http://", "https://")):
        return base + ["-re", "-stream_loop", "-1", "-i", url] + output, None
    for _ in range(3):
        request = urllib.request.Request(url, headers={"Icy-MetaData": "1", "User-Agent": USER_AGENT})
        response = urllib.request.urlopen(request, timeout=10)
        kind = (response.headers.get("Content-Type") or "").lower()
        if "mpegurl" in kind or "scpls" in kind or url.lower().split("?")[0].endswith((".m3u", ".pls")):
            target = fakesdr.playlist_url(response.read(65536).decode("utf-8", "replace"))
            response.close()
            if not target:
                raise OSError("empty playlist")
            url = target
            continue
        # a live stream arrives in real time: no -re
        return base + ["-i", "pipe:0"] + output, (response, int(response.headers.get("icy-metaint") or 0))
    raise OSError("playlist nesting too deep")


def feed(reader, process):
    try:
        while not STOP.is_set():
            data = reader.read(16384)
            if not data:
                break
            process.stdin.write(data)
    except (OSError, ValueError, AttributeError):
        pass
    finally:
        try:
            process.stdin.close()
        except OSError:
            pass


def forever():
    while not STOP.wait(0.5):
        pass


def wait(seconds):
    """False if stopped meanwhile."""
    return not STOP.wait(seconds)


def report_ensemble(events, ensemble, channel):
    events.send("ensemble", channel=channel, id=ensemble["ensemble"], label=str(ensemble.get("label") or ""),
                ecc=str(ensemble.get("ecc") or "0xE0"))
    for service in ensemble["services"]:
        events.send("service", channel=channel, sid=service["sid"], label=str(service.get("label") or ""),
                    shortLabel=str(service.get("shortLabel") or service.get("label") or "")[:8], audio=True,
                    dabPlus=True, bitrate=96)
    return len(ensemble["services"])


def play(events, stations, options, base):
    channel = options.channel
    events.send("tuned", channel=channel, frequency=fakesdr.DAB_CHANNELS.get(channel, 0))
    sync = float(os.environ.get("OPENHU_FAKE_SDR_DAB_SYNC_SECONDS", "1.5"))
    ensemble = fakesdr.find_ensemble(stations, channel)
    if not wait(sync if ensemble else max(sync, options.sync_seconds)):
        return 0
    events.send("sync", channel=channel, synced=bool(ensemble))
    if not ensemble:
        forever()
        return 0
    report_ensemble(events, ensemble, channel)
    sid = fakesdr.dab_id(options.service) if options.service else None
    service = next((entry for entry in ensemble["services"] if entry["sid"] == sid), None)
    if not service:
        forever()
        return 0
    if not shutil.which("ffmpeg"):
        events.send("error", code="pcm", message="fake openhu-dab: ffmpeg missing")
        return 3
    try:
        args, source = open_source(service, options.rate or 48000)
    except Exception as error:  # network
        print("fake openhu-dab: %s: %s" % (service.get("url"), error), file=sys.stderr, flush=True)
        events.send("sync", channel=channel, synced=False)
        forever()
        return 0
    events.send("playing", sid=sid, label=service.get("label", ""), dabPlus=True, bitrate=96)
    events.send("audio", rate=options.rate or 48000, channels=2, format="s16le", sourceRate=48000)

    dls = {"text": str(service.get("dls") or service.get("label") or "")}

    def on_title(title):
        if not service.get("dls"):
            dls["text"] = title

    process = subprocess.Popen(args, stdin=subprocess.PIPE if source else subprocess.DEVNULL, stdout=1,
                               stderr=subprocess.DEVNULL, preexec_fn=die_with_parent)
    if source:
        response, metaint = source
        reader = fakesdr.IcyReader(response, metaint, on_title) if metaint else response
        threading.Thread(target=feed, args=(reader, process), daemon=True).start()

    slides = [os.path.join(base, os.path.expanduser(str(path))) for path in service.get("slides", [])]
    seconds = float(service.get("slideSeconds") or 20)
    started, sent_dls, sent_slide, files, counter = time.monotonic(), None, None, [], 0
    try:
        while process.poll() is None and not STOP.is_set():
            if dls["text"] != sent_dls:
                sent_dls = dls["text"]
                events.send("dls", sid=sid, text=sent_dls)
            if slides:
                slide = slides[int((time.monotonic() - started) // seconds) % len(slides)]
                if slide != sent_slide:
                    sent_slide = slide
                    counter += 1
                    send_slide(events, sid, slide, options.slides, counter, files)
            STOP.wait(0.2)
    finally:
        process.kill()
        process.wait()
        if source:
            source[0].close()
        for path in files:
            try:
                os.remove(path)
            except OSError:
                pass
    return 0


def send_slide(events, sid, slide, directory, counter, files):
    try:
        with open(slide, "rb") as file:
            data = file.read()
    except OSError as error:
        print("fake openhu-dab: %s" % error, file=sys.stderr, flush=True)
        return
    mime = "image/png" if data.startswith(b"\x89PNG") else "image/jpeg"
    info = dict(sid=sid, mime=mime, name=os.path.basename(slide), size=len(data))
    if not directory:
        events.send("slide", data=base64.b64encode(data).decode("ascii"), **info)
        return
    path = os.path.join(directory, "slide-%d-%d.%s" % (os.getpid(), counter, "png" if mime == "image/png" else "jpg"))
    with open(path + ".tmp", "wb") as file:
        file.write(data)
    os.replace(path + ".tmp", path)
    files.append(path)
    while len(files) > 2:
        try:
            os.remove(files.pop(0))
        except OSError:
            pass
    events.send("slide", path=path, **info)


def scan(events, stations, options):
    channels = options.channels or list(fakesdr.DAB_CHANNELS)
    delay = float(os.environ.get("OPENHU_FAKE_SDR_DAB_SCAN_SECONDS", "0.1"))
    total = ensembles = 0
    for index, channel in enumerate(channels):
        if STOP.is_set():
            break
        events.send("scan", channel=channel, index=index, total=len(channels), found=total)
        events.send("tuned", channel=channel, frequency=fakesdr.DAB_CHANNELS.get(channel, 0))
        if not wait(delay):
            break
        ensemble = fakesdr.find_ensemble(stations, channel)
        found = report_ensemble(events, ensemble, channel) if ensemble else 0
        ensembles += bool(ensemble)
        total += found
        events.send("channel", channel=channel, ensemble=bool(ensemble), services=found)
    events.send("done", complete=not STOP.is_set(), ensembles=ensembles, services=total)
    return 0


def parse(argv):
    parser = argparse.ArgumentParser(prog="openhu-dab", description="Simulated openhu-dab (fake-sdr)")
    parser.add_argument("-c", "--channel", type=str.upper)
    parser.add_argument("-s", "--service")
    parser.add_argument("--scan", action="store_true")
    parser.add_argument("--channels", type=lambda text: [item.strip().upper() for item in text.split(",") if item])
    parser.add_argument("--sync-seconds", type=float, default=3)
    parser.add_argument("--scan-seconds", type=float, default=10)
    parser.add_argument("-d", "--device", type=int, default=0)
    parser.add_argument("-g", "--gain", default="auto")
    parser.add_argument("-p", "--ppm", type=int, default=0)
    parser.add_argument("-T", "--bias-tee", action="store_true")
    parser.add_argument("--events-fd", type=int, default=2)
    parser.add_argument("--slides")
    parser.add_argument("--rate", type=int, default=48000)
    parser.add_argument("-V", "--version", action="store_true")
    options = parser.parse_args(argv)
    if not options.version and bool(options.scan) == bool(options.channel):
        parser.error("either --channel or --scan")
    for channel in ([options.channel] if options.channel else []) + (options.channels or []):
        if channel not in fakesdr.DAB_CHANNELS:
            parser.error("unknown channel %s (Band III: 5A-13F)" % channel)
    return options


def main(argv):
    options = parse(argv)
    if options.version:
        print("openhu-dab %s (fake-sdr)" % VERSION)
        return 0
    # stdout carries the PCM (ffmpeg writes to it directly), like the real one
    events = Events(options.events_fd)
    try:
        path = fakesdr.stations_path()
        stations = fakesdr.load_stations(path)
    except (OSError, ValueError) as error:
        events.send("error", code="stations", message="fake openhu-dab: %s" % error)
        return 3
    if stations["error"]:
        code = "device-busy" if stations["error"] == "busy" else "no-device"
        events.send("error", code=code, message=fakesdr.ERRORS.get(stations["error"], stations["error"]))
        return 3
    events.send("device", name="fake-sdr", gain=-1, biasTee=options.bias_tee, version=VERSION)
    if options.scan:
        return scan(events, stations, options)
    return play(events, stations, options, os.path.dirname(os.path.abspath(path)))


if __name__ == "__main__":
    die_with_parent()
    for number in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(number, lambda *_: STOP.set())
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    sys.exit(main(sys.argv[1:]))
