#!/usr/bin/env python3
"""Simulated welle-cli (see fakesdr.py): only the web server mode the radio plugin uses (-c channel -w port).

Serves like welle-cli 2.4: /mux.json (ensemble and services of the "dab" section of the station list), /mp3/<sid>
(the service's stream, tone or file as MP3 via ffmpeg, decoded on demand), /slide/<sid> (the service's "slides"),
POST /channel (retune). With "error" in the list it runs on like the real one does without a stick: with its
"Null device", no ensembles. The ensemble shows up OPENHU_FAKE_SDR_DAB_SYNC_SECONDS (default 1.5) after a tune, like a
receiver that has to sync; a channel without an ensemble in the list stays empty. DLS: "dls", else the stream's
ICY title, else the label; only while the service is decoded, like welle-cli. Unlike welle-cli it listens on
127.0.0.1 only."""

import ctypes
import http.server
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.request

import fakesdr

USER_AGENT = "OpenHU-fake-sdr/1.0"


class Receiver:
    def __init__(self, stations, channel):
        self.stations = stations
        self.lock = threading.Lock()
        self.generation = 0
        self.decoding = {}  # sid -> {"dls", "mot", "slide"}
        self.tune(channel)

    def tune(self, channel):
        with self.lock:
            self.channel = channel.upper()
            self.tuned_at = time.monotonic()
            self.generation += 1
            self.decoding = {}

    def ensemble(self):
        if self.stations["error"]:
            return None
        sync = float(os.environ.get("OPENHU_FAKE_SDR_DAB_SYNC_SECONDS", "1.5"))
        if time.monotonic() - self.tuned_at < sync:
            return None
        return fakesdr.find_ensemble(self.stations, self.channel)

    def service(self, sid):
        ensemble = self.ensemble()
        sid = fakesdr.dab_id(sid)
        return next((service for service in (ensemble or {}).get("services", []) if service["sid"] == sid), None)


def open_source(service):
    """ffmpeg arguments producing MP3 on stdout, plus an optional (response, metaint) to feed its stdin."""
    output = ["-vn", "-ac", "2", "-ar", "48000", "-c:a", "libmp3lame", "-b:a", "128k", "-f", "mp3", "pipe:1"]
    base = ["ffmpeg", "-hide_banner", "-nostats", "-loglevel", "error"]
    if service.get("tone"):
        return base + ["-re", "-f", "lavfi", "-i", "sine=frequency=%d" % int(service["tone"])] + output, None
    url = str(service.get("url") or "")
    if not url.startswith(("http://", "https://")):
        return base + ["-re", "-stream_loop", "-1", "-i", url] + output, None
    for _ in range(3):
        request = urllib.request.Request(url, headers={"Icy-MetaData": "1", "User-Agent": USER_AGENT})
        response = urllib.request.urlopen(request, timeout=10)
        kind = (response.headers.get("Content-Type") or "").lower()
        if "mpegurl" in kind or "scpls" in kind or url.lower().split("?")[0].endswith((".m3u", ".pls")):
            target = fakesdr.playlist_url(response.read(65536).decode("utf-8", "replace"))
            response.close()
            if not target:
                raise OSError("empty playlist")
            url = target
            continue
        return base + ["-i", "pipe:0"] + output, (response, int(response.headers.get("icy-metaint") or 0))
    raise OSError("playlist nesting too deep")


class Handler(http.server.BaseHTTPRequestHandler):
    receiver = None
    base = "."

    def log_message(self, *args):
        pass

    def send(self, status, body, kind="text/plain"):
        self.send_response(status)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length).decode(errors="replace").strip()
        if self.path != "/channel":
            return self.send(404, b"Not found")
        print("POST channel: " + body, file=sys.stderr, flush=True)
        self.receiver.tune(body)
        self.send(200, b"Retuning...")

    def do_GET(self):
        receiver = self.receiver
        if self.path == "/mux.json":
            with receiver.lock:
                state = {sid: dict(value) for sid, value in receiver.decoding.items()}
            mux = fakesdr.welle_mux(receiver.ensemble(), state, int(time.time()),
                                    "Null device" if receiver.stations["error"] else "fake-sdr")
            return self.send(200, json.dumps(mux).encode(), "application/json")
        if self.path.startswith("/slide/"):
            service = receiver.service(self.path[len("/slide/"):])
            with receiver.lock:
                slide = (receiver.decoding.get(service["sid"]) or {}).get("slide") if service else None
            if not slide:
                return self.send(404, b"404 Not Found\r\nSlide not available.\r\n")
            with open(slide, "rb") as file:
                data = file.read()
            return self.send(200, data, "image/png" if data.startswith(b"\x89PNG") else "image/jpeg")
        if self.path.startswith("/mp3/"):
            service = receiver.service(self.path[len("/mp3/"):])
            if not service:
                return self.send(404, b"Not found")
            return self.stream(service)
        self.send(404, b"Not found")

    def stream(self, service):
        receiver, sid = self.receiver, service["sid"]
        generation = receiver.generation
        if not shutil.which("ffmpeg"):
            return self.send(500, b"fake welle-cli: ffmpeg missing")
        try:
            args, source = open_source(service)
        except Exception as error:  # network
            print("fake welle-cli: %s: %s" % (service.get("url"), error), file=sys.stderr, flush=True)
            return self.send(503, b"stream not available")
        started = time.time()
        slides = [os.path.join(self.base, os.path.expanduser(str(path))) for path in service.get("slides", [])]
        seconds = float(service.get("slideSeconds") or 20)
        with receiver.lock:
            receiver.decoding[sid] = {"dls": str(service.get("dls") or service.get("label") or ""), "mot": 0,
                                      "slide": None}

        def on_title(title):
            if not service.get("dls"):
                with receiver.lock:
                    if sid in receiver.decoding:
                        receiver.decoding[sid]["dls"] = title

        process = subprocess.Popen(args, stdin=subprocess.PIPE if source else subprocess.DEVNULL,
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, preexec_fn=die_with_parent)
        if source:
            response, metaint = source
            reader = fakesdr.IcyReader(response, metaint, on_title) if metaint else response
            threading.Thread(target=feed, args=(reader, process), daemon=True).start()
        self.send_response(200)
        self.send_header("Content-Type", "audio/mpeg")
        self.end_headers()
        try:
            while receiver.generation == generation:
                if slides:
                    index = int((time.time() - started) // seconds) % len(slides)
                    with receiver.lock:
                        state = receiver.decoding.get(sid)
                        if state and state["slide"] != slides[index]:
                            state["slide"], state["mot"] = slides[index], int(time.time() * 1000)
                data = process.stdout.read1(16384)
                if not data:
                    break
                self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            process.kill()
            process.wait()
            if source:
                source[0].close()
            with receiver.lock:
                if receiver.generation == generation:
                    receiver.decoding.pop(sid, None)


def die_with_parent():
    """ffmpeg ends with this process (SIGTERM ends it with os._exit, which does not stop its children)."""
    try:
        ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    except (OSError, AttributeError):
        pass


def feed(reader, process):
    try:
        while True:
            data = reader.read(16384)
            if not data:
                break
            process.stdin.write(data)
    except (OSError, ValueError, AttributeError):
        pass
    finally:
        try:
            process.stdin.close()
        except OSError:
            pass


def main(argv):
    options, index = {}, 0
    while index < len(argv):
        if argv[index] in ("-c", "-w", "-g", "-F", "-C", "-s", "-A", "-f", "-p", "-t") and index + 1 < len(argv):
            options[argv[index]] = argv[index + 1]
            index += 2
        else:
            index += 1
    if "-w" not in options or "-c" not in options:
        print("fake welle-cli: only the web server mode is simulated (-c <channel> -w <port>)", file=sys.stderr)
        return 1
    try:
        path = fakesdr.stations_path()
        stations = fakesdr.load_stations(path)
    except (OSError, ValueError) as error:
        print("fake welle-cli: %s" % error, file=sys.stderr)
        return 1
    if stations["error"]:
        # welle-cli 2.4 does not end without a stick
        print("RTL_SDR: No devices found\nError: No valid device found use Null device instead.", file=sys.stderr,
              flush=True)
    print("welle-cli 2.4 (fake-sdr), channel %s" % options["-c"], file=sys.stderr, flush=True)
    Handler.receiver = Receiver(stations, options["-c"])
    Handler.base = os.path.dirname(os.path.abspath(path))
    server = http.server.ThreadingHTTPServer(("127.0.0.1", int(options["-w"])), Handler)
    server.daemon_threads = True
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    import signal
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
    sys.exit(main(sys.argv[1:]))
