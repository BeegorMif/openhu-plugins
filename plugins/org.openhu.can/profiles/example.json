{
  "name": "Beispiel (vcan0-Demo)",
  "description": "Demo-Profil zum Testen mit vcan0 und cansend, siehe README. Für ein echtes Auto ein eigenes Profil mit dessen CAN-IDs anlegen.",
  "signals": [
    {"id": "0x100", "topic": "speed", "field": "kmh", "byte": 0, "length": 16, "endian": "big", "scale": 0.01},
    {"id": "0x100", "topic": "engine", "field": "rpm", "byte": 2, "length": 16, "endian": "big"},
    {"id": "0x200", "topic": "gear", "field": "reverse", "byte": 0, "bit": 0, "length": 1},
    {"id": "0x200", "topic": "lights", "field": "headlights", "byte": 0, "bit": 1, "length": 1},
    {"id": "0x200", "topic": "climate", "field": "outsideTemp", "byte": 1, "length": 8, "signed": true, "scale": 0.5}
  ],
  "buttons": [
    {"id": "0x300", "byte": 0, "mask": "0x01", "action": "volume.up"},
    {"id": "0x300", "byte": 0, "mask": "0x02", "action": "volume.down"},
    {"id": "0x300", "byte": 0, "mask": "0x04", "action": "media.next"},
    {"id": "0x300", "byte": 0, "mask": "0x08", "action": "media.previous"},
    {"id": "0x300", "byte": 0, "mask": "0x10", "action": "voice"},
    {"id": "0x300", "byte": 0, "mask": "0x20", "action": "call.answer"},
    {"id": "0x300", "byte": 0, "mask": "0x40", "action": "call.end"},
    {"id": "0x300", "byte": 0, "mask": "0x80", "action": "media.play_pause"}
  ],
  "controls": [
    {"name": "temperature", "area": "driver", "min": 16, "max": 28, "step": 0.5,
     "read": {"id": "0x3A0", "byte": 0, "length": 8, "scale": 0.5},
     "write": {"id": "0x3B0", "data": "01 00 00 00 00 00 00 00", "byte": 1, "length": 8, "scale": 0.5}},
    {"name": "temperature", "area": "passenger", "min": 16, "max": 28, "step": 0.5,
     "read": {"id": "0x3A0", "byte": 1, "length": 8, "scale": 0.5},
     "write": {"id": "0x3B0", "data": "02 00 00 00 00 00 00 00", "byte": 1, "length": 8, "scale": 0.5}},
    {"name": "seatHeating", "area": "driver", "min": 0, "max": 3,
     "read": {"id": "0x3A0", "byte": 2, "bit": 0, "length": 2},
     "write": {"id": "0x3B0", "data": "03 00 00 00 00 00 00 00", "byte": 1, "length": 8}},
    {"name": "ac", "area": "front",
     "read": {"id": "0x3A0", "byte": 2, "bit": 4, "length": 1},
     "write": {"id": "0x3B0", "data": "04 00 00 00 00 00 00 00", "byte": 1, "length": 8}}
  ],
  "triggers": [
    {"topic": "gear", "field": "reverse", "equals": true,
     "then": {"action": "camera.show"}, "else": {"action": "camera.hide"}},
    {"topic": "lights", "field": "headlights", "equals": true,
     "then": {"method": "daynight.set", "params": {"night": true}},
     "else": {"method": "daynight.set", "params": {"night": false}}}
  ]
}
