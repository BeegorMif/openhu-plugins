{
  "name": "BMW F20",
  "description": "BMW F20 CAN signals derived from can.js; verify on vehicle",
  "signals": [
    {"id": "0x1A1", "topic": "speed", "field": "mph", "byte": 2, "length": 16, "endian": "little", "scale": 0.01},
    {"id": "0x2CA", "topic": "climate", "field": "outsideTemp", "byte": 0, "length": 8, "scale": 0.5, "offset": -40},
    {"id": "0x2E6", "topic": "climate", "field": "temperatureC", "byte": 7, "length": 8, "scale": 0.5},
    {"id": "0x2E6", "topic": "climate", "field": "fanSpeed", "byte": 5, "length": 8},
    {"id": "0x202", "topic": "dashboard", "field": "brightnessRaw", "byte": 0, "length": 8},
    {"id": "0x3B4", "topic": "battery", "field": "engineStatusByte", "byte": 2, "length": 8},
    {"id": "0x330", "topic": "fuel", "field": "averageFuelLitres", "byte": 3, "length": 8},
    {"id": "0x349", "topic": "fuel", "field": "leftFuelRaw", "byte": 0, "length": 16, "endian": "little", "scale": 0.00625},
    {"id": "0x349", "topic": "fuel", "field": "rightFuelRaw", "byte": 2, "length": 16, "endian": "little", "scale": 0.00625},
    {"id": "0x21A", "topic": "lights", "field": "dipBeam", "byte": 0, "bit": 0, "length": 1},
    {"id": "0x21A", "topic": "lights", "field": "mainBeam", "byte": 0, "bit": 1, "length": 1},
    {"id": "0x21A", "topic": "lights", "field": "sideLights", "byte": 0, "bit": 2, "length": 1},
    {"id": "0x21A", "topic": "lights", "field": "brakeLights", "byte": 0, "bit": 7, "length": 1},
    {"id": "0x21A", "topic": "lights", "field": "reverseLights", "byte": 1, "bit": 0, "length": 1},
    {"id": "0x130", "topic": "ignition", "field": "terminalR", "byte": 0, "bit": 0, "length": 1},
    {"id": "0x130", "topic": "ignition", "field": "terminal15", "byte": 0, "bit": 2, "length": 1},
    {"id": "0x3A7", "topic": "drivingMode", "field": "b2", "byte": 2, "length": 8},
    {"id": "0x3A7", "topic": "drivingMode", "field": "b3", "byte": 3, "length": 8},
    {"id": "0x3A7", "topic": "drivingMode", "field": "dtcOff", "byte": 6, "bit": 2, "length": 1},
    {"id": "0x3F9", "topic": "battery", "field": "stopStartActive", "byte": 6, "bit": 1, "length": 1},
    {"id": "0x330", "topic": "odometer", "field": "km","byte": 0,"length": 24,"signed": false,"scale": 1}
  ],
  "buttons": [],
  "triggers": [
    {"topic": "lights", "field": "dipBeam", "equals": true,
     "then": {"method": "daynight.set", "params": {"night": true}},
     "else": {"method": "daynight.set", "params": {"night": false}}},
    {"topic": "lights", "field": "dipBeam", "equals": true,
     "then": {"method": "ui.toast", "params": {"text": "Dipped headlights on", "duration": 2500}},
     "else": {"method": "ui.toast", "params": {"text": "Dipped headlights off", "duration": 2500}}},
    {"topic": "climate","field": "temperatureC","diff": 1,
      "then": {"method": "ui.toast","params": {"text": "Interior temperature: %1°C","duration": 2500}}},
    {"topic": "climate","field": "outsideTemp","diff": 1,
      "then": {"method": "ui.toast","params": {"text": "Outside temperature: %1°C","duration": 2500}}},
    {"topic": "drivingMode","field": "b3","equals": 4,
      "then": {"method": "ui.toast","params": {"text": "Driving mode: Sport","duration": 2500}}},
    {"topic": "drivingMode","field": "b2","equals": 0,
      "then": {"method": "ui.toast","params": {"text": "Driving mode: Comfort","duration": 2500}},
      "else": {"method": "ui.toast","params": {"text": "Driving mode: Eco","duration": 2500}}}
  ],
  "controls": [
    {"name": "temperature", "area": "driver", "min": 16, "max": 32, "step": 0.5,
     "read": {"id": "0x2E6", "byte": 7, "length": 8, "scale": 0.5}
    },
    {"name": "temperature", "area": "passenger", "min": 16, "max": 28, "step": 0.5,
     "read": {"id": "0x2E6", "byte": 7, "length": 8, "scale": 0.5}
    },
    {"name": "fanSpeed", "area": "driver", "min": 0, "max": 7, "step": 1,
     "read": {"id": "0x2E6", "byte": 5, "length": 8}
    },
    {"name": "fanSpeed", "area": "passenger", "min": 0, "max": 7, "step": 1,
     "read": {"id": "0x2E6", "byte": 5, "length": 8}
    },
    {"name": "ignition",
     "read": {"id": "0x130", "byte": 0, "bit": 2, "length": 1}}
  ]
}